# ── Nexus CRM environment ─────────────────────────────────────────────
# Copy to .env for docker compose. ALL secrets MUST be replaced in production.

# JWT signing secret — generate: openssl rand -base64 64
CRM_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
# AES key for encrypting email credentials at rest — generate: openssl rand -base64 32
CRM_ENCRYPTION_KEY=dev-only-encryption-key-change-me-0123456789abcdef

# Database (compose wires these automatically; override for external DB)
CRM_DB_URL=jdbc:postgresql://localhost:5432/crm
CRM_DB_USERNAME=crm
CRM_DB_PASSWORD=crm
# Redis (optional: only for login rate limiting). Dev easiest:
#   docker compose up -d redis     (starts Redis 7 with a health check)
# Without Redis the app still runs; the rate limiter fails OPEN and logs one
# warning per minute. Never disable it in production.
CRM_REDIS_URL=redis://localhost:6379

# Seed: the admin account created on first boot. CHANGE THE PASSWORD IN PRODUCTION.
CRM_ADMIN_EMAIL=alinasir.swe@gmail.com
CRM_ADMIN_PASSWORD=hello@ali123

# Mail / onboarding emails. For Gmail: enable 2FA, create an App Password, and use:
#   CRM_MAIL_HOST=smtp.gmail.com  CRM_MAIL_PORT=587
#   CRM_MAIL_USERNAME=hazeljones.cse@gmail.com  CRM_MAIL_PASSWORD=<16-char app password>
CRM_MAIL_HOST=smtp.gmail.com
CRM_MAIL_PORT=587
CRM_MAIL_USERNAME=ammadhamid721@gmail.com
CRM_MAIL_PASSWORD=gqmxjwqwraxhnnzm
CRM_MAIL_FROM=ammadhamid721@gmail.com

# Android calling bridge (per-user cellular calling). Generate the token: openssl rand -hex 32
# CRM_BRIDGE_URL is only a GLOBAL fallback: the recommended setup is that each user runs
# bridge/android-bridge.js next to their phone - it announces its own URL + device id via
# the shared-token heartbeat, so per-device routing works without this variable.
# See bridge/README.md for the full phone + adb setup.
CRM_BRIDGE_URL=
CRM_BRIDGE_TOKEN=

# Public URL used in links (unsubscribe, proposal view, tracking)
CRM_APP_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS
CRM_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Seed demo data in dev profile (admin@nexuscrm.local / Admin123!)
CRM_SEED=true

# AI assistant — optional. Without a key the deterministic rule-based provider is used.
CRM_AI_API_KEY=
CRM_AI_BASE_URL=https://api.openai.com/v1
CRM_AI_MODEL=gpt-4o-mini

# ── Optional (defaults shown) ─────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=dev          # use 'prod' in production
# CRM_ORG_NAME=My Company             # default organization name (onboarding creates the real one)
# CRM_STORAGE_DIR=./data/storage      # document upload folder
# CRM_RATE_LIMIT=true                 # set false ONLY to disable login rate limiting (Redis down, dev)
